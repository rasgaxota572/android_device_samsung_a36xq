/system                    erofs     system                                                    flags=display=system;logical;slotselect
/system                    f2fs      system                                                    flags=display=system;logical;slotselect
/system                    ext4      system                                                    flags=display=system;logical;slotselect
/system_ext                erofs     system_ext                                                flags=display=system_ext;logical;slotselect
/product                   erofs     product                                                   flags=display=product;logical;slotselect
/vendor                    erofs     vendor                                                    flags=display=vendor;logical;slotselect
/vendor_dlkm               erofs     vendor_dlkm                                               flags=display=vendor_dlkm;logical;slotselect
/system_dlkm               erofs     system_dlkm                                               flags=display=system_dlkm;logical;slotselect
/system_dlkm               f2fs      system_dlkm                                               flags=display=system_dlkm;logical;slotselect
/system_dlkm               ext4      system_dlkm                                               flags=display=system_dlkm;logical;slotselect
/odm                       erofs     odm                                                       flags=display=odm;logical;slotselect
/metadata                  f2fs      /dev/block/by-name/metadata                               flags=display=metadata
/data                      f2fs      /dev/block/bootdevice/by-name/userdata                    flags=display=data
/mnt/vendor/persist        ext4      /dev/block/bootdevice/by-name/persist                     flags=display=persist
/misc                      emmc      /dev/block/bootdevice/by-name/misc                        flags=display=misc
/vendor/firmware_mnt       vfat      /dev/block/bootdevice/by-name/apnhlos                     flags=display=firmware_mnt;slotselect
/vendor/firmware-modem     vfat      /dev/block/bootdevice/by-name/modem                       flags=display=firmware-modem;slotselect
/mnt/vendor/efs            ext4      /dev/block/bootdevice/by-name/efs                         flags=display=efs
/efs                       ext4      /dev/block/bootdevice/by-name/sec_efs                     flags=display=efs
/vendor/dsp                ext4      /dev/block/bootdevice/by-name/dsp                         flags=display=dsp;slotselect
/vendor_boot               emmc      /dev/block/bootdevice/by-name/vendor_boot                 flags=display=vendor_boot;slotselect
/init_boot                 emmc      /dev/block/bootdevice/by-name/init_boot                   flags=display=init_boot;slotselect
/prism                     ext4      /dev/block/by-name/prism                                  flags=display=prism;slotselect
/optics                    ext4      /dev/block/by-name/optics                                 flags=display=optics;slotselect
auto                       vfat      /devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*     flags=display=auto
auto                       auto      /devices/platform/soc/8804000.sdhci/mmc_host*             flags=display=auto
/cache                     ext4      /dev/block/by-name/cache                                  flags=display=cache
